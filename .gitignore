# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules

# Build / compiled output
dist
tmp
out-tsc
out
*.tsbuildinfo

# Next.js
.next

# Nest / local app build outputs
apps/*/dist

# Nx
.nx

# CDK
cdk.out

# Test / lint / tooling caches
coverage
.cache
.eslintcache
.sass-cache
connect.lock
libpeerconnection.log
testem.log
typings

# Local environment / secrets
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
**/auth0*secrets*.json
**/auth0 secrets*.json

# Package manager hygiene (this workspace uses pnpm-lock.yaml)
package-lock.json
yarn.lock
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# IDEs and editors
.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode (keep shared workspace defaults)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Claude / local agent settings
.claude/worktrees
.claude/settings.local.json

# System Files
.DS_Store
Thumbs.db
Desktop.ini
